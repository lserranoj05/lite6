<?xml version="1.0"?>
<sdf version="1.7">
  <world name="base_world">
<!-- Gravedad -->
<!--
<gravity>0 0 0</gravity>
-->
 <!-- Suelo manual -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

<model name="mesa_flotacion">
  <static>true</static>
  <pose>0 0 0.05 0 0 0</pose>

  <!-- Superficie de la mesa-->
  <link name="superficie">
    <pose>0 0 0.05 0 0 0</pose>
    <collision name="col_superficie">
      <geometry>
        <box>
          <size>2 2 0.1</size>
        </box>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.0</mu>
            <mu2>0.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis_superficie">
      <geometry>
        <box>
          <size>2 2 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>0 0 0 1</ambient>
        <diffuse>0 0 0 1</diffuse>
      </material>
    </visual>
  </link>
<!-- PAREDES -->

  <!-- Borde izquierdo-->
  <link name="borde_izquierdo">
    <pose>-0.975 0 0.125 0 0 0</pose>
    <collision name="col_borde_izq">
      <geometry>
        <box>
          <size>0.05 2 0.1</size>
        </box>
      </geometry>
    </collision>
    <visual name="vis_borde_izq">
      <geometry>
        <box>
          <size>0.05 2 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- Borde derecho-->
  <link name="borde_derecho">
    <pose>0.975 0 0.125 0 0 0</pose>
    <collision name="col_borde_der">
      <geometry>
        <box>
          <size>0.05 2 0.1</size>
        </box>
      </geometry>
    </collision>
    <visual name="vis_borde_der">
      <geometry>
        <box>
          <size>0.05 2 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- Borde frontal-->
  <link name="borde_frontal">
    <pose>0 0.975 0.125 0 0 0</pose>
    <collision name="col_borde_front">
      <geometry>
        <box>
          <size>2 0.05 0.1</size>
        </box>
      </geometry>
    </collision>
    <visual name="vis_borde_front">
      <geometry>
        <box>
          <size>2 0.05 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- Borde trasero-->
  <link name="borde_trasero">
    <pose>0 -0.975 0.125 0 0 0</pose>
    <collision name="col_borde_back">
      <geometry>
        <box>
          <size>2 0.05 0.1</size>
        </box>
      </geometry>
    </collision>
    <visual name="vis_borde_back">
      <geometry>
        <box>
          <size>2 0.05 0.1</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 -0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
    </light>

  </world>
</sdf>
