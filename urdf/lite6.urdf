        </geometry>
      </collision>
      
    </link>

    <joint name="joint2" type="revolute">
      <origin
        xyz="0 0 0"
        rpy="1.5708 -1.5708 3.1416" />
      <parent
        link="link1" />
      <child
        link="link2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.61799"
        upper="2.61799"
        effort="32.0"
        velocity="3.14"/>
      <dynamics damping="0.0" friction="0.0"/>
